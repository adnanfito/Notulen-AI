# ---------------------------------------------------------------------------
# notulen-ai — example configuration
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
PORT=8080

# --- Host ports ------------------------------------------------------------
# Only these are published, and only on loopback. Change them if another
# project on this machine already uses one (the defaults avoid the common
# 5173/8080/5432 trio).
FRONTEND_PORT=5273
BACKEND_PORT=8180
# Dev-only, from docker-compose.override.yml:
STT_PORT=8200
POSTGRES_PORT=55432

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_notes

# Hostname "postgres" is the compose service name; use localhost only if you
# run the backend outside Docker.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/meeting_notes?sslmode=disable

# --- STT service -----------------------------------------------------------
STT_URL=http://stt:8000
STT_MAX_RETRIES=2
STT_TIMEOUT_SECONDS=600

# --- Whisper (STT container) ----------------------------------------------
# Keep the model within the 1.5 GB VRAM budget. Use "base" if "small" exceeds
# it on your GPU. Set WHISPER_DEVICE=cpu on machines without CUDA.
# Measured on an RTX 4070 Laptop with 90 s chunks:
#   small  + int8 -> 625 MiB peak, 27x realtime
#   medium + int8 -> 1521 MiB peak, 16x realtime, noticeably more accurate
# medium sits right at the PRD's 1.5 GB ceiling (1536 MiB) with ~1% headroom.
# Drop to small if you need the VRAM for something else on the same GPU.
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
# Upload cap, temp scratch dir (wiped after every request), and the duration
# below which a chunk is treated as silence rather than an error.
STT_MAX_UPLOAD_MB=128
STT_TEMP_DIR=/tmp/stt-uploads
STT_MIN_AUDIO_SECONDS=0.3

# Biases decoding. Keep it domain-neutral unless your meetings really are all
# one subject — naming a field drags unrelated meetings toward its vocabulary.
# For a run of technical meetings you might add: "Istilah teknis seperti
# backend, API, deployment, database, Docker."
WHISPER_INITIAL_PROMPT=Rekaman rapat. Bahasa Indonesia, English, atau campuran Indo-English. Tulis nama orang, angka, tanggal, dan istilah asing sesuai yang diucapkan, dengan tanda baca yang wajar.

# --- Audio -----------------------------------------------------------------
AUDIO_CHUNK_SECONDS=90
AUDIO_TEMP_DIR=/tmp/meeting-chunks
# Keep chunk audio on disk after transcription (debugging only).
KEEP_AUDIO=false

# --- LLM summarization -----------------------------------------------------
# Only the transcript is sent to the provider. Audio never leaves this machine.
LLM_PROVIDER=gemini

# Primary model. Newer stable Flash models exist (gemini-3.8-flash is the
# latest); 3.5 is the "legacy" tier — fast and cheap, adequate for notes.
LLM_MODEL=gemini-3.5-flash

# Tried in order when the primary answers 503 (model overloaded) or 429 (rate
# limited). Comma-separated. A different model often has capacity when one is
# swamped, and partial notes beat no notes.
LLM_FALLBACK_MODELS=gemini-2.5-flash

# Attempts per model before moving to the next one. Backoff is exponential
# with jitter, and the server's Retry-After header wins when present.
LLM_MAX_RETRIES=3

# Ceiling on the generated notes. Thorough notes for a multi-hour meeting run
# long; too low a value truncates the JSON and the parse fails.
LLM_MAX_OUTPUT_TOKENS=32768

LLM_API_KEY=

# --- SSE -------------------------------------------------------------------
SSE_HEARTBEAT_SECONDS=15

# --- Frontend --------------------------------------------------------------
# Empty = same-origin (dev server proxies /api to the backend).
VITE_API_BASE=
# Browser-side chunk length; keep it in step with AUDIO_CHUNK_SECONDS.
VITE_AUDIO_CHUNK_SECONDS=90
